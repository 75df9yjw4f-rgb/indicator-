// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// =====================================================================================
//  CVD STRUCTURAL DIVERGENCE SCALPER  -  BTCUSDT 1m
// =====================================================================================
//  CONCEPT
//  -------
//  PRICE STRUCTURE  <->  CVD STRUCTURE
//        -> 4 types of structural mismatch (HH/LH, LL/HL, HL/LL, LH/HH)
//        -> wait for ONE EMA cross inside a limited window
//        -> LONG / SHORT -> SL / TP -> Strategy Tester
//
//  The script compares every NEW confirmed price pivot against the last N confirmed
//  pivots of the SAME kind (not only the previous one), and compares the matched CVD
//  pivots in exactly the same way. That "scan the last N historical pivots" behaviour
//  is the core of the system, see input "Historical Pivots To Scan".
//
//  TECHNICAL LIMITATION (stated openly, not faked)
//  -----------------------------------------------
//  Pine Script cannot read the numeric output of TradingView's built-in
//  "Cumulative Volume Delta" indicator. There is no API to pull a value out of another
//  script. Therefore this strategy BUILDS its own CVD from lower-timeframe (intrabar)
//  data via request.security_lower_tf(), which is exactly the same data source and the
//  same classification logic that the built-in CVD uses. See the CVD ENGINE section for
//  the full description. No lookahead, no future data, no repainting of signals.
// =====================================================================================

//@version=6
strategy(
  title                   = "CVD Structural Divergence Scalper [1m]",
  shorttitle              = "CVD-SDS",
  overlay                 = false,   // own pane = CVD; price objects use force_overlay
  precision               = 2,
  pyramiding              = 0,       // hard guarantee: only ONE open position at a time
  initial_capital         = 10000,
  currency                = currency.USD,
  default_qty_type        = strategy.percent_of_equity,
  default_qty_value       = 10,
  commission_type         = strategy.commission.percent,
  commission_value        = 0.04,    // BTCUSDT perp taker fee, change in Properties tab
  slippage                = 1,       // in ticks, change in Properties tab
  process_orders_on_close = true,    // <- set to FALSE for a true "next bar open" fill
  calc_on_every_tick      = true,    // needed for the optional intrabar EMA cross mode
  use_bar_magnifier       = false,
  max_lines_count         = 500,
  max_labels_count        = 500,
  max_boxes_count         = 100,
  max_bars_back           = 1000)

// =====================================================================================
//  INPUTS - 1. CVD ENGINE
// =====================================================================================
string G_CVD = "1 - CVD Engine"

cvdMode      = input.string("Intrabar (lower timeframe)", "CVD calculation",
   options = ["Intrabar (lower timeframe)", "Bar-based approximation"], group = G_CVD,
   tooltip = "Intrabar: every lower-timeframe candle inside the current 1m candle is " +
             "classified as buy or sell volume (this is how a real CVD works).\n" +
             "Bar-based: no intrabar data is requested, the 1m candle itself is split " +
             "into buy/sell volume by its shape. Used automatically as a fallback when " +
             "intrabar data is not available for your plan/symbol/history depth.")
cvdLtf       = input.timeframe("15S", "Intrabar timeframe", group = G_CVD,
   tooltip = "Must be LOWER than the chart timeframe. 1S/5S/10S/15S/30S need a paid " +
             "TradingView plan. TradingView limits the total number of intrabars that " +
             "can be requested (20k-200k depending on plan), so the smaller this value " +
             "is, the shorter the usable backtest history. 15S on a 1m chart = 4 " +
             "intrabars per candle.")
cvdResetMode = input.string("None (continuous)", "CVD reset",
   options = ["None (continuous)", "Daily session", "Weekly"], group = G_CVD,
   tooltip = "A reset creates a discontinuity in the CVD series. Pivots that belong to " +
             "different CVD epochs are NEVER compared with each other, so structure " +
             "stays valid across resets.")
cvdSrcPivot  = input.string("CVD High / Low", "CVD pivots are taken from",
   options = ["CVD High / Low", "CVD Close"], group = G_CVD,
   tooltip = "The script builds a full CVD candle (open/high/low/close) by walking the " +
             "cumulative delta path inside every chart bar. 'CVD High/Low' uses those " +
             "wicks for pivot detection, 'CVD Close' uses the closing CVD value only.")

// =====================================================================================
//  INPUTS - 2. PRICE STRUCTURE
// =====================================================================================
string G_PS = "2 - Price Structure"

pLeft      = input.int(5, "Price Pivot Left",  minval = 1, maxval = 50, group = G_PS)
pRight     = input.int(3, "Price Pivot Right", minval = 1, maxval = 50, group = G_PS,
   tooltip = "A price pivot is only CONFIRMED after this many bars have closed to the " +
             "right of it. Signals can never be generated before that moment - this is " +
             "the main anti-repaint guarantee.")
pSrcMode   = input.string("High / Low", "Price pivot source",
   options = ["High / Low", "Close"], group = G_PS)

// =====================================================================================
//  INPUTS - 3. CVD STRUCTURE
// =====================================================================================
string G_CS = "3 - CVD Structure"

cLeft      = input.int(5, "CVD Pivot Left",  minval = 1, maxval = 50, group = G_CS)
cRight     = input.int(3, "CVD Pivot Right", minval = 1, maxval = 50, group = G_CS,
   tooltip = "Same confirmation rule as for price pivots, applied to the CVD series.")

// =====================================================================================
//  INPUTS - 4. DIVERGENCE ENGINE
// =====================================================================================
string G_DIV = "4 - Divergence Engine"

histScan     = input.int(20, "Historical Pivots To Scan", minval = 1, maxval = 100, group = G_DIV,
   tooltip = "THE core setting. A new confirmed price pivot is compared against the " +
             "last N confirmed pivots of the same kind (H vs H, L vs L), not only " +
             "against the previous one. 20 = compare H21 with H20, H19, H18 ... H1.")
maxStored    = input.int(60, "Max Stored Pivots", minval = 10, maxval = 300, group = G_DIV,
   tooltip = "Ring-buffer size for every pivot array. Older pivots are dropped. " +
             "Keeps CPU/memory bounded on 1m charts.")
matchWin     = input.int(6, "Pivot Matching Window (bars)", minval = 0, maxval = 60, group = G_DIV,
   tooltip = "Price and CVD rarely pivot on the very same candle. A price pivot is " +
             "matched with the CLOSEST CVD pivot of the same kind within +/- this many " +
             "bars. High is only ever matched with High, Low only with Low.")
maxDivPerPiv = input.int(3, "Max Divergences Per New Pivot", minval = 1, maxval = 20, group = G_DIV,
   tooltip = "One new pivot can build a valid divergence with several historical " +
             "pivots. This caps how many of them are kept/drawn so the chart stays readable.")
maxDivDraw   = input.int(12, "Max Divergences Displayed", minval = 1, maxval = 60, group = G_DIV)
minPriceDiff = input.float(0.0, "Min Price Pivot Difference (%)", minval = 0, step = 0.01, group = G_DIV,
   tooltip = "0 = disabled. Filters out pairs whose two price pivots are practically equal.")
minCvdDiff   = input.float(0.0, "Min CVD Pivot Difference (%)", minval = 0, step = 0.1, group = G_DIV,
   tooltip = "0 = disabled. Percentage is measured against the recent CVD range.")

// The four structural mismatch types. No 'bullish'/'bearish' sections in the UI - just
// the four types, exactly as requested.
useT1 = input.bool(true, "Type 1:  Price HH  +  CVD LH", group = G_DIV)
useT2 = input.bool(true, "Type 2:  Price LL  +  CVD HL", group = G_DIV)
useT3 = input.bool(true, "Type 3:  Price HL  +  CVD LL", group = G_DIV)
useT4 = input.bool(true, "Type 4:  Price LH  +  CVD HH", group = G_DIV)

dirFilter    = input.string("Strict Direction", "Divergence Direction Filter",
   options = ["Strict Direction", "Any Divergence"], group = G_DIV,
   tooltip = "Strict Direction: type 2 and type 3 (structurally bullish) may only open " +
             "LONG, type 1 and type 4 (structurally bearish) may only open SHORT.\n" +
             "Any Divergence: any live divergence arms the system and the EMA cross " +
             "alone decides the direction.")
selMode      = input.string("Latest Valid Divergence", "Divergence Selection Mode",
   options = ["Latest Valid Divergence", "Any Valid Divergence"], group = G_DIV,
   tooltip = "Latest: only the newest still-living divergence is consulted when the EMA " +
             "crosses. Any: every still-living divergence is consulted. All detected " +
             "divergences are drawn on the chart in both modes.")

// =====================================================================================
//  INPUTS - 5. EMA & SIGNAL WINDOW  (ONE single EMA, never two)
// =====================================================================================
string G_EMA = "5 - EMA & Signal Window"

emaLen      = input.int(20, "EMA Length", minval = 1, maxval = 500, group = G_EMA)
emaSrc      = input.source(close, "EMA Source", group = G_EMA)
emaConfirm  = input.string("On Bar Close", "EMA Cross Confirmation",
   options = ["On Bar Close", "Intrabar / realtime"], group = G_EMA,
   tooltip = "On Bar Close (default, NON-REPAINTING): the cross must be true when the " +
             "bar closes. Intrabar: the cross is accepted the moment it happens inside " +
             "a live bar - this can un-happen before the bar closes, so it repaints in " +
             "real time. Historical bars are identical in both modes, therefore the " +
             "backtest itself always stays non-repainting.")
maxBarsAfter = input.int(15, "Max Bars After Divergence", minval = 1, maxval = 200, group = G_EMA,
   tooltip = "The EMA confirmation window. A divergence detected on bar D is alive on " +
             "bars D+1 ... D+15 (default). A cross on bar D+16 is ignored and the " +
             "divergence is marked as expired.")
allowSameBar = input.bool(false, "Allow EMA cross on the divergence bar itself", group = G_EMA)
consumeDiv   = input.bool(true, "Consume divergences after a signal", group = G_EMA,
   tooltip = "ON: once a signal is produced, the divergences that were alive are " +
             "deactivated so the same divergence cannot fire twice.")

// =====================================================================================
//  INPUTS - 6. ENTRY / POSITION
// =====================================================================================
string G_ENT = "6 - Entry & Position"

entryMode  = input.string("Signal Candle Close", "Entry Mode",
   options = ["Signal Candle Close", "Next Candle Open"], group = G_ENT,
   tooltip = "Signal Candle Close (default): the order is sent on the signal bar and, " +
             "because the script is declared with process_orders_on_close = true, it is " +
             "filled at that bar's CLOSE. No lookahead - the close is known when the " +
             "bar closes.\n" +
             "Next Candle Open: the order is delayed by one bar. NOTE: Pine's " +
             "process_orders_on_close flag is a compile-time constant, so with the " +
             "default declaration the delayed order fills at the NEXT bar's close. For " +
             "a true next-bar-OPEN fill change process_orders_on_close to false in the " +
             "strategy() header (line 37) - then this mode is exact.")
sizeMode   = input.string("Strategy Properties", "Position Size Mode",
   options = ["Strategy Properties", "Contracts", "% of Equity", "Cash (quote currency)"],
   group = G_ENT,
   tooltip = "Strategy Properties = use the qty defined in the Properties tab.")
sizeValue  = input.float(10, "Position Size Value", minval = 0, step = 0.1, group = G_ENT)
revOnOpp   = input.bool(false, "Reverse on opposite signal", group = G_ENT,
   tooltip = "OFF (default, as specified): an opposite signal never opens a new trade " +
             "while a position is open - it is only displayed and counted. With Take " +
             "Profit = 'Opposite Signal' the open trade is still CLOSED by it. " +
             "ON: the position is closed and immediately reversed.")
sameBarMode = input.string("Conservative (SL first)", "Same Bar TP/SL Resolution",
   options = ["Conservative (SL first)", "Optimistic (TP first)"], group = G_ENT,
   tooltip = "What to assume when one candle contains both the stop and the target.\n" +
             "Conservative (default): both levels are armed as an OCA stop/limit pair; " +
             "Pine's broker emulator resolves the ambiguity with its worst-case rule, " +
             "i.e. the stop.\n" +
             "Optimistic: only the take profit is armed, so a candle that touches both " +
             "is filled at the target; a candle that breaches the stop alone is closed " +
             "at that candle's close. Collisions are counted in the statistics table.")

// =====================================================================================
//  INPUTS - 7. STOP LOSS
// =====================================================================================
string G_SL = "7 - Stop Loss"

slMode     = input.string("Swing / Pivot SL", "Stop Loss Mode",
   options = ["Swing / Pivot SL", "Fixed Percentage SL", "ATR-based SL", "Fixed Points/Ticks SL"],
   group = G_SL)
slPct      = input.float(0.35, "Fixed Percentage SL (%)", minval = 0.01, step = 0.05, group = G_SL)
atrLen     = input.int(14, "ATR Length", minval = 1, group = G_SL,
   tooltip = "Shared by the ATR stop loss and the ATR take profit.")
atrMultSL  = input.float(1.5, "ATR Multiplier (SL)", minval = 0.1, step = 0.1, group = G_SL)
slTicks    = input.int(500, "Fixed Points/Ticks SL", minval = 1, group = G_SL,
   tooltip = "In ticks (syminfo.mintick). BTCUSDT perp tick = 0.1, so 500 ticks = 50 USD.")
swingBack  = input.int(10, "Swing SL: pivots to look back", minval = 1, maxval = 100, group = G_SL,
   tooltip = "For a LONG the engine walks back through the confirmed structural LOWS " +
             "and takes the most recent one that is actually below the entry price. " +
             "Mirrored for SHORT.")
slBufTicks = input.int(10, "Swing SL: extra buffer (ticks)", minval = 0, group = G_SL)
slMinPct   = input.float(0.05, "Min SL distance (%)", minval = 0.0, step = 0.01, group = G_SL)
slMaxPct   = input.float(2.00, "Max SL distance (%)", minval = 0.1, step = 0.1, group = G_SL,
   tooltip = "Safety clamp for the swing stop: a structural low that is further away " +
             "than this is replaced by this distance.")

// =====================================================================================
//  INPUTS - 8. TAKE PROFIT
// =====================================================================================
string G_TP = "8 - Take Profit"

tpMode     = input.string("Risk / Reward", "Take Profit Mode",
   options = ["Risk / Reward", "Fixed Percentage", "ATR-based", "Fixed Points/Ticks", "Opposite Signal"],
   group = G_TP)
rrRatio    = input.float(1.5, "Risk/Reward ratio (1 : X)", minval = 0.1, step = 0.1, group = G_TP)
tpPct      = input.float(0.5, "Fixed Percentage TP (%)", minval = 0.01, step = 0.05, group = G_TP)
atrMultTP  = input.float(2.5, "ATR Multiplier (TP)", minval = 0.1, step = 0.1, group = G_TP)
tpTicks    = input.int(1000, "Fixed Points/Ticks TP", minval = 1, group = G_TP)

// =====================================================================================
//  INPUTS - 9. BACKTEST WINDOW
// =====================================================================================
string G_BT = "9 - Backtest"

useDates   = input.bool(true, "Limit backtest to a date range", group = G_BT)
btStart    = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Backtest Start Date", group = G_BT)
btEnd      = input.time(timestamp("01 Jan 2099 00:00 +0000"), "Backtest End Date",   group = G_BT)
closeAtEnd = input.bool(true, "Close open position at the end of the range", group = G_BT)
dispComm   = input.float(0.04, "Commission shown in table (%)", minval = 0, step = 0.01, group = G_BT,
   tooltip = "Initial capital, commission and slippage of the BACKTEST itself live in " +
             "the Strategy Tester -> Properties tab, because Pine requires them to be " +
             "compile-time constants in the strategy() header. The table shows the real " +
             "commission actually charged (summed from the closed trades) plus these " +
             "reference values, so keep them in sync with the Properties tab.")
dispSlip   = input.int(1, "Slippage shown in table (ticks)", minval = 0, group = G_BT)

// =====================================================================================
//  INPUTS - 10. VISUALS
// =====================================================================================
string G_VIS = "10 - Visuals"

showEma      = input.bool(true,  "Show EMA (main chart)",                group = G_VIS)
showPPiv     = input.bool(true,  "Show price pivots + HH/HL/LH/LL",      group = G_VIS)
showCPiv     = input.bool(true,  "Show CVD pivots + HH/HL/LH/LL",        group = G_VIS)
showDiv      = input.bool(true,  "Show divergence lines + type labels",  group = G_VIS)
showSignals  = input.bool(true,  "Show LONG/SHORT SIGNAL labels",        group = G_VIS)
showLevels   = input.bool(true,  "Show Entry / SL / TP levels",          group = G_VIS)
cvdCandles   = input.bool(true,  "Draw CVD as candles (else line)",      group = G_VIS)
colUp        = input.color(color.new(#26a69a, 0), "Bullish structure colour", group = G_VIS)
colDn        = input.color(color.new(#ef5350, 0), "Bearish structure colour", group = G_VIS)
colPivP      = input.color(color.new(#787b86, 0), "Price pivot colour",       group = G_VIS)
colPivC      = input.color(color.new(#2962ff, 0), "CVD pivot colour",         group = G_VIS)

string G_TBL = "11 - Statistics Table"
showTable    = input.bool(true, "Show statistics table", group = G_TBL)
tblPos       = input.string("Top Right", "Table position",
   options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = G_TBL)
tblSize      = input.string("Tiny", "Table text size",
   options = ["Tiny", "Small", "Normal"], group = G_TBL)

// =====================================================================================
//  CVD ENGINE
// =====================================================================================
//  WHY THIS CODE EXISTS
//  --------------------
//  Pine Script has NO function that returns the value of another script, therefore the
//  numeric output of TradingView's built-in "Cumulative Volume Delta" indicator cannot
//  be read from here. This block rebuilds it from the very same raw material the
//  built-in indicator uses: lower-timeframe (intrabar) candles.
//
//  HOW IT IS CALCULATED
//  --------------------
//  1. request.security_lower_tf() returns an array holding every intrabar candle that
//     belongs to the CURRENT chart bar. It can only ever contain data that already
//     exists at that moment -> no future data, no lookahead, nothing to repaint.
//  2. Each intrabar candle is classified with the standard rule:
//        close > open  -> its whole volume counts as BUY volume   (delta = +volume)
//        close < open  -> its whole volume counts as SELL volume  (delta = -volume)
//        close = open  -> tick rule: compare to the previous intrabar close; if that is
//                         flat as well, the last known direction is carried forward.
//  3. barDelta = sum of the intrabar deltas  ->  this is the CANDLE DELTA.
//  4. cvd = cvd[1] + barDelta                ->  this is the CUMULATIVE VOLUME DELTA.
//  5. While summing, the running cumulative value is tracked, which yields a genuine
//     CVD CANDLE (open / high / low / close). Structure is later read from THOSE candle
//     values, never from a smoothed line.
//
//  Three different things are therefore kept strictly apart in this script:
//     price          -> open/high/low/close of the chart
//     candle delta   -> barDelta (per-bar buy minus sell volume, NOT cumulative)
//     CVD            -> cvdOpen/cvdHigh/cvdLow/cvdClose (running cumulative delta)
// =====================================================================================

int chartSec = timeframe.in_seconds(timeframe.period)
int ltfSec   = timeframe.in_seconds(cvdLtf)
// Guard: request.security_lower_tf() needs a timeframe strictly lower than the chart's.
string safeLtf = ltfSec >= chartSec ? (chartSec > 1 ? "1S" : timeframe.period) : cvdLtf

// Single lower-timeframe request. Global scope, no lookahead parameter anywhere.
[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, safeLtf, [open, close, volume])

var float cvd      = 0.0   // running cumulative volume delta
var int   cvdEpoch = 0     // +1 on every reset; pivots of different epochs never pair
var int   lastDir  = 1     // last known tick-rule direction

bool cvdReset = cvdResetMode == "Daily session" ? timeframe.change("D")
   : cvdResetMode == "Weekly" ? timeframe.change("W") : false

float prevCvd = nz(cvd)
if cvdReset
    prevCvd  := 0.0
    cvdEpoch += 1

float barDelta = 0.0
float runVal   = prevCvd
float runHi    = prevCvd
float runLo    = prevCvd
int   nIntra   = math.min(array.size(ltfC), math.min(array.size(ltfO), array.size(ltfV)))
bool  intraOk  = cvdMode == "Intrabar (lower timeframe)" and nIntra > 0

if intraOk
    float prevIntraClose = na
    for i = 0 to nIntra - 1
        float o = array.get(ltfO, i)
        float c = array.get(ltfC, i)
        float v = nz(array.get(ltfV, i))
        int   d = c > o ? 1 : c < o ? -1 :
               na(prevIntraClose) ? lastDir :
               c > prevIntraClose ? 1 : c < prevIntraClose ? -1 : lastDir
        lastDir        := d
        prevIntraClose := c
        barDelta       += d * v
        runVal         += d * v
        runHi          := math.max(runHi, runVal)
        runLo          := math.min(runLo, runVal)
else
    // FALLBACK (also used when the plan/symbol/history depth gives no intrabar data):
    // the chart candle itself is split into buy and sell volume by its shape.
    // buy  = volume * (close - low ) / (high - low)
    // sell = volume * (high - close) / (high - low)
    float rng = high - low
    barDelta := rng > 0 ? nz(volume) * ((close - low) - (high - close)) / rng
       : close > nz(close[1], close) ? nz(volume) : close < nz(close[1], close) ? -nz(volume) : 0.0
    runVal := prevCvd + barDelta
    runHi  := math.max(prevCvd, runVal)
    runLo  := math.min(prevCvd, runVal)

cvd := prevCvd + barDelta

float cvdOpen  = prevCvd
float cvdClose = cvd
float cvdHigh  = math.max(runHi, cvd)
float cvdLow   = math.min(runLo, cvd)

// ------------------------------------------------------------------ pivot sources ---
float pSrcHi = pSrcMode == "High / Low" ? high : close
float pSrcLo = pSrcMode == "High / Low" ? low  : close
float cSrcHi = cvdSrcPivot == "CVD High / Low" ? cvdHigh : cvdClose
float cSrcLo = cvdSrcPivot == "CVD High / Low" ? cvdLow  : cvdClose

// ------------------------------------------------------------------ shared series ---
float emaVal = ta.ema(emaSrc, emaLen)
float atrVal = ta.atr(atrLen)
float cvdRng = ta.highest(cvdHigh, 200) - ta.lowest(cvdLow, 200)   // scale for % filters

// ------------------------------------------------------------------ CVD rendering ---
plotcandle(cvdCandles ? cvdOpen : na, cvdCandles ? cvdHigh : na, cvdCandles ? cvdLow : na,
   cvdCandles ? cvdClose : na, title = "CVD candles",
   color = cvdClose >= cvdOpen ? color.new(colUp, 30) : color.new(colDn, 30),
   wickcolor = color.new(color.gray, 40), bordercolor = cvdClose >= cvdOpen ? colUp : colDn)
plot(cvdCandles ? na : cvdClose, "CVD line", color = colPivC, linewidth = 2)
hline(0, "CVD zero", color = color.new(color.gray, 60), linestyle = hline.style_dotted)
plot(barDelta, "Candle delta (per bar, not cumulative)", display = display.data_window)
plot(nIntra,   "Intrabars used for this candle",         display = display.data_window)

// EMA is a MAIN-CHART object -> force_overlay = true. Exactly ONE EMA exists here.
plot(showEma ? emaVal : na, "EMA", color = color.new(#ff9800, 0), linewidth = 2,
   force_overlay = true)

// =====================================================================================
//  STRUCTURE ENGINE - confirmed pivots, HH / HL / LH / LL, ring buffers
// =====================================================================================
//  ta.pivothigh(src, left, right) returns a value only AFTER `right` bars have closed to
//  the right of the pivot candle. On the confirmation bar the pivot itself sits at
//  bar_index - right. Everything below therefore works with data that was already final
//  at the confirmation bar  ->  no repainting of the structure, no lookahead.
// =====================================================================================

type Piv
    int    bar        // bar_index of the pivot candle itself
    int    confBar    // bar_index on which the pivot became confirmed
    float  val        // pivot value (price, or CVD)
    int    epoch      // CVD epoch the pivot belongs to
    string tag        // "HH" / "HL" / "LH" / "LL" / "H" / "L"
    float  mVal       // matched counterpart value (CVD value of a price pivot)
    int    mBar       // bar of the matched counterpart, na while unmatched

type Div
    int    bar        // bar_index where the divergence became KNOWN (detection bar)
    int    typ        // 1..4
    bool   bull       // true = structurally bullish, false = structurally bearish
    bool   alive      // still inside the EMA window and not consumed yet
    int    pNewBar
    int    pOldBar

var array<Piv> phArr = array.new<Piv>()   // confirmed PRICE pivot highs
var array<Piv> plArr = array.new<Piv>()   // confirmed PRICE pivot lows
var array<Piv> chArr = array.new<Piv>()   // confirmed CVD   pivot highs
var array<Piv> clArr = array.new<Piv>()   // confirmed CVD   pivot lows
var array<Div> divArr = array.new<Div>()  // divergence events

var array<int> dedupN = array.new<int>()  // emitted pairs, "new" pivot bar
var array<int> dedupO = array.new<int>()  // emitted pairs, "old" pivot bar

var array<line>  divLines  = array.new<line>()
var array<label> divLabels = array.new<label>()

int hardCap = math.max(maxStored, histScan + 5)

// --------------------------------------------------------------------- helpers ------
trimPiv(array<Piv> a) =>
    while array.size(a) > hardCap
        array.shift(a)

// structural classification against the PREVIOUS pivot of the same kind
tagFor(array<Piv> a, float v, bool isHigh) =>
    string t = isHigh ? "H" : "L"
    if array.size(a) > 0
        float pv = array.get(a, array.size(a) - 1).val
        t := isHigh ? (v > pv ? "HH" : "LH") : (v < pv ? "LL" : "HL")
    t

// closest counterpart pivot (same kind!) within +/- matchWin bars, -1 when none
findMatch(array<Piv> src, int b) =>
    int best = -1
    int bestD = 1000000
    int n = array.size(src)
    if n > 0
        int lo = math.max(0, n - 1 - 40)
        for i = n - 1 to lo
            Piv p = array.get(src, i)
            int d = math.abs(p.bar - b)
            if d <= matchWin and d < bestD
                bestD := d
                best  := i
            if p.bar < b - matchWin - 500
                break
    best

alreadyEmitted(int nb, int ob) =>
    bool found = false
    int n = array.size(dedupN)
    if n > 0
        int lo = math.max(0, n - 300)
        for i = n - 1 to lo
            if array.get(dedupN, i) == nb and array.get(dedupO, i) == ob
                found := true
                break
    found

pushDedup(int nb, int ob) =>
    array.push(dedupN, nb)
    array.push(dedupO, ob)
    while array.size(dedupN) > 400
        array.shift(dedupN)
        array.shift(dedupO)

// keeps the number of drawn divergence groups bounded (2 lines + 2 labels per group)
trimDraw() =>
    while array.size(divLines) > maxDivDraw * 2
        line.delete(array.shift(divLines))
    while array.size(divLabels) > maxDivDraw * 2
        label.delete(array.shift(divLabels))

// --------------------------------------------------------- confirmed pivot values ---
float phRaw = ta.pivothigh(pSrcHi, pLeft,  pRight)
float plRaw = ta.pivotlow(pSrcLo, pLeft,  pRight)
float chRaw = ta.pivothigh(cSrcHi, cLeft,  cRight)
float clRaw = ta.pivotlow(cSrcLo, cLeft,  cRight)

int pPivBar = bar_index - pRight
int cPivBar = bar_index - cRight

// =====================================================================================
//  DIVERGENCE ENGINE
// =====================================================================================
//  A new confirmed PRICE pivot is compared with the last N confirmed price pivots of the
//  SAME KIND (High vs High, Low vs Low - never High vs Low), N = "Historical Pivots To
//  Scan". For every pair the matched CVD pivots are compared the same way, and the four
//  structural mismatches are:
//
//     Type 1 : Price HH + CVD LH   (bearish structure)
//     Type 2 : Price LL + CVD HL   (bullish structure)
//     Type 3 : Price HL + CVD LL   (bullish structure)
//     Type 4 : Price LH + CVD HH   (bearish structure)
//
//  The comparison is structural: both endpoints are CONFIRMED pivots, and the CVD value
//  used for each endpoint is the value of the CVD pivot that was matched to that price
//  pivot - never the CVD value of an arbitrary candle.
// =====================================================================================

divName(int t) =>
    switch t
        1 => "T1  Price HH / CVD LH"
        2 => "T2  Price LL / CVD HL"
        3 => "T3  Price HL / CVD LL"
        => "T4  Price LH / CVD HH"

scanPairs(array<Piv> pArr, bool isHigh, int anchorIdx) =>
    int made = 0
    if anchorIdx >= 1 and anchorIdx < array.size(pArr)
        Piv pn = array.get(pArr, anchorIdx)
        if not na(pn.mBar)
            int stopIdx = math.max(0, anchorIdx - histScan)
            for j = anchorIdx - 1 to stopIdx
                if made >= maxDivPerPiv
                    break
                Piv po = array.get(pArr, j)
                if not na(po.mBar) and po.epoch == pn.epoch and po.val != 0
                    bool pHigher = pn.val  > po.val
                    bool pLower  = pn.val  < po.val
                    bool cHigher = pn.mVal > po.mVal
                    bool cLower  = pn.mVal < po.mVal
                    // optional noise filters
                    bool pOk = minPriceDiff <= 0 or
                       math.abs(pn.val - po.val) / math.abs(po.val) * 100.0 >= minPriceDiff
                    bool cOk = minCvdDiff <= 0 or (cvdRng > 0 and
                       math.abs(pn.mVal - po.mVal) / cvdRng * 100.0 >= minCvdDiff)
                    int  typ = 0
                    bool bull = false
                    if pOk and cOk
                        if isHigh and pHigher and cLower and useT1
                            typ := 1
                            bull := false
                        else if isHigh and pLower and cHigher and useT4
                            typ := 4
                            bull := false
                        else if not isHigh and pLower and cHigher and useT2
                            typ := 2
                            bull := true
                        else if not isHigh and pHigher and cLower and useT3
                            typ := 3
                            bull := true
                    if typ > 0 and not alreadyEmitted(pn.bar, po.bar)
                        pushDedup(pn.bar, po.bar)
                        made += 1
                        // The detection bar is the CURRENT bar: this is the first moment
                        // at which both pivots and both matches are known. Signals may
                        // only start from here -> no back-dated signal, no repaint.
                        array.push(divArr, Div.new(bar_index, typ, bull, true, pn.bar, po.bar))
                        while array.size(divArr) > 60
                            array.shift(divArr)
                        if showDiv
                            color cl = bull ? colUp : colDn
                            // price side (main chart)
                            array.push(divLines, line.new(po.bar, po.val, pn.bar, pn.val,
                               xloc = xloc.bar_index, color = cl, width = 2,
                               style = line.style_solid, force_overlay = true))
                            array.push(divLabels, label.new(pn.bar, pn.val, divName(typ),
                               xloc = xloc.bar_index,
                               yloc = isHigh ? yloc.abovebar : yloc.belowbar,
                               style = isHigh ? label.style_label_down : label.style_label_up,
                               color = color.new(cl, 20), textcolor = color.white,
                               size = size.small, force_overlay = true))
                            // CVD side (this pane)
                            array.push(divLines, line.new(po.mBar, po.mVal, pn.mBar, pn.mVal,
                               xloc = xloc.bar_index, color = cl, width = 2,
                               style = line.style_dashed))
                            array.push(divLabels, label.new(pn.mBar, pn.mVal,
                               isHigh ? (cLower ? "LH" : "HH") : (cHigher ? "HL" : "LL"),
                               xloc = xloc.bar_index,
                               style = isHigh ? label.style_label_down : label.style_label_up,
                               color = color.new(cl, 20), textcolor = color.white,
                               size = size.tiny))
                            trimDraw()
    made

// =====================================================================================
//  PIVOT INGESTION  (price first, then CVD, then late matches)
// =====================================================================================
int divMadeThisBar = 0

// ---- new confirmed PRICE pivot HIGH --------------------------------------------------
if not na(phRaw)
    string tg = tagFor(phArr, phRaw, true)
    Piv p = Piv.new(pPivBar, bar_index, phRaw, cvdEpoch, tg, na, na)
    int m = findMatch(chArr, pPivBar)
    if m >= 0
        Piv cm = array.get(chArr, m)
        p.mVal := cm.val
        p.mBar := cm.bar
    array.push(phArr, p)
    trimPiv(phArr)
    if showPPiv
        label.new(pPivBar, phRaw, tg, xloc = xloc.bar_index, yloc = yloc.abovebar,
           style = label.style_label_down, color = color.new(colPivP, 70),
           textcolor = colPivP, size = size.tiny, force_overlay = true)
    divMadeThisBar += scanPairs(phArr, true, array.size(phArr) - 1)

// ---- new confirmed PRICE pivot LOW ---------------------------------------------------
if not na(plRaw)
    string tg = tagFor(plArr, plRaw, false)
    Piv p = Piv.new(pPivBar, bar_index, plRaw, cvdEpoch, tg, na, na)
    int m = findMatch(clArr, pPivBar)
    if m >= 0
        Piv cm = array.get(clArr, m)
        p.mVal := cm.val
        p.mBar := cm.bar
    array.push(plArr, p)
    trimPiv(plArr)
    if showPPiv
        label.new(pPivBar, plRaw, tg, xloc = xloc.bar_index, yloc = yloc.belowbar,
           style = label.style_label_up, color = color.new(colPivP, 70),
           textcolor = colPivP, size = size.tiny, force_overlay = true)
    divMadeThisBar += scanPairs(plArr, false, array.size(plArr) - 1)

// A CVD pivot can be confirmed LATER than the price pivot it belongs to. When that
// happens the price pivot receives its counterpart now, and the pair scan is re-run for
// that pivot and for the few newer ones (the dedupe list stops duplicates).
scanFrom(array<Piv> a, bool isHigh, int fromIdx) =>
    int tot = 0
    int last = math.min(array.size(a) - 1, fromIdx + 3)
    if fromIdx >= 0 and fromIdx <= last
        for k = fromIdx to last
            tot += scanPairs(a, isHigh, k)
    tot

// ---- new confirmed CVD pivot HIGH ----------------------------------------------------
if not na(chRaw)
    string tg = tagFor(chArr, chRaw, true)
    array.push(chArr, Piv.new(cPivBar, bar_index, chRaw, cvdEpoch, tg, na, na))
    trimPiv(chArr)
    if showCPiv
        label.new(cPivBar, chRaw, tg, xloc = xloc.bar_index, yloc = yloc.price,
           style = label.style_label_down, color = color.new(colPivC, 75),
           textcolor = colPivC, size = size.tiny)
    int n = array.size(phArr)
    if n > 0
        for i = n - 1 to math.max(0, n - 40)
            Piv pp = array.get(phArr, i)
            int d = math.abs(pp.bar - cPivBar)
            if d <= matchWin and (na(pp.mBar) or math.abs(pp.mBar - pp.bar) > d)
                pp.mVal := chRaw
                pp.mBar := cPivBar
                divMadeThisBar += scanFrom(phArr, true, i)
            if pp.bar < cPivBar - matchWin - 500
                break

// ---- new confirmed CVD pivot LOW -----------------------------------------------------
if not na(clRaw)
    string tg = tagFor(clArr, clRaw, false)
    array.push(clArr, Piv.new(cPivBar, bar_index, clRaw, cvdEpoch, tg, na, na))
    trimPiv(clArr)
    if showCPiv
        label.new(cPivBar, clRaw, tg, xloc = xloc.bar_index, yloc = yloc.price,
           style = label.style_label_up, color = color.new(colPivC, 75),
           textcolor = colPivC, size = size.tiny)
    int n = array.size(plArr)
    if n > 0
        for i = n - 1 to math.max(0, n - 40)
            Piv pp = array.get(plArr, i)
            int d = math.abs(pp.bar - cPivBar)
            if d <= matchWin and (na(pp.mBar) or math.abs(pp.mBar - pp.bar) > d)
                pp.mVal := clRaw
                pp.mBar := cPivBar
                divMadeThisBar += scanFrom(plArr, false, i)
            if pp.bar < cPivBar - matchWin - 500
                break

// ---- expire divergences that left the EMA confirmation window ------------------------
int dCnt = array.size(divArr)
if dCnt > 0
    for i = dCnt - 1 to math.max(0, dCnt - 40)
        Div d = array.get(divArr, i)
        if d.alive and bar_index - d.bar > maxBarsAfter
            d.alive := false

// =====================================================================================
//  EMA CROSS  (exactly ONE EMA)  +  SIGNAL LOGIC
// =====================================================================================
//  A divergence is NEVER an entry by itself. It only arms the system for
//  "Max Bars After Divergence" bars; the trade is born on the EMA cross inside that
//  window. In "On Bar Close" mode the cross must survive to the close of the bar, which
//  is what makes the signal non-repainting.
// =====================================================================================

bool rawUp = ta.crossover(close, emaVal)
bool rawDn = ta.crossunder(close, emaVal)
bool crossUp = emaConfirm == "On Bar Close" ? (rawUp and barstate.isconfirmed) : rawUp
bool crossDn = emaConfirm == "On Bar Close" ? (rawDn and barstate.isconfirmed) : rawDn

// Does a living divergence allow a trade in the requested direction?
//   Strict Direction : bullish structure -> LONG only, bearish structure -> SHORT only
//   Any Divergence   : any living divergence arms both directions
//   Latest mode      : only the newest ELIGIBLE divergence is consulted
//   Any mode         : all living divergences are consulted
divPermits(bool wantLong) =>
    bool ok  = false
    int  typ = 0
    int  n   = array.size(divArr)
    if n > 0
        for i = n - 1 to math.max(0, n - 40)
            Div d = array.get(divArr, i)
            if d.alive
                int age = bar_index - d.bar
                if age >= (allowSameBar ? 0 : 1) and age <= maxBarsAfter
                    bool dirOk = dirFilter == "Any Divergence" ? true : (wantLong ? d.bull : not d.bull)
                    if dirOk
                        ok  := true
                        typ := d.typ
                        break
                    else if selMode == "Latest Valid Divergence"
                        break
    [ok, typ]

[longDivOk,  longDivTyp]  = divPermits(true)
[shortDivOk, shortDivTyp] = divPermits(false)

bool inWindow = not useDates or (time >= btStart and time <= btEnd)

bool longSignal  = crossUp and longDivOk  and inWindow
bool shortSignal = crossDn and shortDivOk and inWindow

// consume the divergences that produced the signal (also when no trade is opened)
if (longSignal or shortSignal) and consumeDiv
    int n = array.size(divArr)
    if n > 0
        for i = n - 1 to math.max(0, n - 40)
            Div d = array.get(divArr, i)
            if d.alive and bar_index - d.bar <= maxBarsAfter
                d.alive := false

// =====================================================================================
//  RISK MODULE - SL / TP / SIZE
// =====================================================================================
calcSL(bool isLong, float px) =>
    float sl = na
    if slMode == "Fixed Percentage SL"
        sl := isLong ? px * (1 - slPct / 100.0) : px * (1 + slPct / 100.0)
    else if slMode == "ATR-based SL"
        sl := isLong ? px - atrVal * atrMultSL : px + atrVal * atrMultSL
    else if slMode == "Fixed Points/Ticks SL"
        sl := isLong ? px - slTicks * syminfo.mintick : px + slTicks * syminfo.mintick
    else
        // Swing / Pivot: walk back through the CONFIRMED structural lows (for a long)
        // and take the most recent one that actually sits below the entry price.
        float buf = slBufTicks * syminfo.mintick
        int n = isLong ? array.size(plArr) : array.size(phArr)
        if n > 0
            for i = n - 1 to math.max(0, n - swingBack)
                float v = isLong ? array.get(plArr, i).val : array.get(phArr, i).val
                if isLong and v < px
                    sl := v - buf
                    break
                if not isLong and v > px
                    sl := v + buf
                    break
        if na(sl)   // no usable swing -> ATR fallback, never an undefined stop
            sl := isLong ? px - atrVal * atrMultSL : px + atrVal * atrMultSL
    float d    = math.abs(px - sl)
    float minD = px * slMinPct / 100.0
    float maxD = px * slMaxPct / 100.0
    if na(d) or d < minD
        d := minD
    if slMode == "Swing / Pivot SL" and d > maxD
        d := maxD
    isLong ? px - d : px + d

calcTP(bool isLong, float px, float sl) =>
    float risk = math.abs(px - sl)
    float tp = na
    if tpMode == "Risk / Reward"
        tp := isLong ? px + risk * rrRatio : px - risk * rrRatio
    else if tpMode == "Fixed Percentage"
        tp := isLong ? px * (1 + tpPct / 100.0) : px * (1 - tpPct / 100.0)
    else if tpMode == "ATR-based"
        tp := isLong ? px + atrVal * atrMultTP : px - atrVal * atrMultTP
    else if tpMode == "Fixed Points/Ticks"
        tp := isLong ? px + tpTicks * syminfo.mintick : px - tpTicks * syminfo.mintick
    tp   // "Opposite Signal" -> na, the position is closed by the opposite signal

calcQty(float px) =>
    float q = na
    if sizeMode == "Contracts"
        q := sizeValue
    else if sizeMode == "% of Equity"
        q := px > 0 ? strategy.equity * sizeValue / 100.0 / px : na
    else if sizeMode == "Cash (quote currency)"
        q := px > 0 ? sizeValue / px : na
    q    // "Strategy Properties" -> na -> the Properties tab sizing is used

// =====================================================================================
//  EXECUTION  -  ONLY ONE OPEN POSITION AT A TIME
// =====================================================================================
//  A signal that arrives while a position is open is still drawn on the chart and still
//  counted in "Signals Generated", but it does NOT become a trade (pyramiding = 0 plus
//  the explicit check below). "Trades Actually Opened" counts the real entries.
// =====================================================================================

var int pendingDir   = 0    // used by the "Next Candle Open" entry mode
var int sigLongCnt   = 0
var int sigShortCnt  = 0
var int tradesOpened = 0
var int blockedSigs  = 0

int execDir = entryMode == "Signal Candle Close" ? (longSignal ? 1 : shortSignal ? -1 : 0)
   : pendingDir

if longSignal
    sigLongCnt += 1
if shortSignal
    sigShortCnt += 1

// Take Profit mode "Opposite Signal" closes the running trade (no reversal by default).
if tpMode == "Opposite Signal" and not revOnOpp
    if strategy.position_size > 0 and shortSignal
        strategy.close("L", comment = "Opposite signal")
    if strategy.position_size < 0 and longSignal
        strategy.close("S", comment = "Opposite signal")

var float curSL       = na
var float curTP       = na
var float curEntry    = na
var int   curDirV     = 0
var int   curTradeBar = na
var bool  posArmed    = false
var int   collisions  = 0
var array<float> riskQ = array.new<float>()

if execDir != 0 and inWindow
    bool flat = strategy.position_size == 0
    bool longOpp  = execDir == 1  and strategy.position_size < 0
    bool shortOpp = execDir == -1 and strategy.position_size > 0
    bool opp = longOpp or shortOpp
    if flat or (revOnOpp and opp)
        // The fill price is already known: with process_orders_on_close = true a market
        // order sent now is filled at THIS bar's close. SL/TP are therefore derived
        // immediately and the protective orders are armed on the very same bar, so the
        // trade is never left unprotected for a bar.
        curDirV     := execDir
        curEntry    := close
        curSL       := calcSL(execDir == 1, close)
        curTP       := calcTP(execDir == 1, close, curSL)
        curTradeBar := bar_index
        posArmed    := true
        array.push(riskQ, math.abs(curEntry - curSL))
        while array.size(riskQ) > 20
            array.shift(riskQ)
        float q = calcQty(close)
        if execDir == 1
            strategy.entry("L", strategy.long,  qty = q, comment = "LONG")
        else
            strategy.entry("S", strategy.short, qty = q, comment = "SHORT")
        tradesOpened += 1
    else
        blockedSigs += 1

// queue for the next bar AFTER execDir has been consumed
if entryMode == "Next Candle Open"
    pendingDir := longSignal ? 1 : shortSignal ? -1 : 0

// --------------------------------------------- protective orders of the open trade --
bool inPos = strategy.position_size != 0

// the trade is finished: flat again and the entry bar has passed
if posArmed and not inPos and bar_index > nz(curTradeBar, bar_index)
    posArmed    := false
    curSL       := na
    curTP       := na
    curEntry    := na
    curDirV     := 0
    curTradeBar := na

if posArmed and not na(curSL)
    bool   isL     = curDirV == 1
    string fromId  = isL ? "L" : "S"
    bool   tpArmed = not na(curTP)
    if sameBarMode == "Conservative (SL first)" or not tpArmed
        // OCA stop/limit pair. When a single candle contains both levels the broker
        // emulator resolves the ambiguity with its worst-case assumption - the stop.
        // That is exactly the Conservative behaviour.
        strategy.exit("EXIT-" + fromId, from_entry = fromId, stop = curSL, limit = curTP,
           comment_profit = "TP", comment_loss = "SL")
    else
        // Optimistic: only the target is armed, so a candle holding both levels is
        // filled at the target. A candle that breaches the stop without touching the
        // target closes the position at that candle's close.
        strategy.exit("EXIT-" + fromId, from_entry = fromId, limit = curTP, comment_profit = "TP")
        if bar_index > nz(curTradeBar, bar_index)
            bool slHit = isL ? low  <= curSL : high >= curSL
            bool tpHit = isL ? high >= curTP : low  <= curTP
            if slHit and not tpHit
                strategy.close(fromId, comment = "SL (bar close)")
    // how often did one single candle contain BOTH levels?
    if tpArmed and inPos and bar_index > nz(curTradeBar, bar_index)
        bool both = isL ? (low <= curSL and high >= curTP) : (high >= curSL and low <= curTP)
        if both
            collisions += 1

if useDates and closeAtEnd and time > btEnd and strategy.position_size != 0
    strategy.close_all(comment = "Backtest range end")

// ------------------------------------------------------------------- signal visuals --
plotshape(showSignals and longSignal, "LONG SIGNAL", shape.labelup, location.belowbar,
   color.new(#26a69a, 0), text = "LONG", textcolor = color.white, size = size.tiny,
   force_overlay = true)
plotshape(showSignals and shortSignal, "SHORT SIGNAL", shape.labeldown, location.abovebar,
   color.new(#ef5350, 0), text = "SHORT", textcolor = color.white, size = size.tiny,
   force_overlay = true)

plot((showLevels and posArmed) ? curEntry : na, "Entry", color = color.new(#2962ff, 0),
   style = plot.style_linebr, linewidth = 1, force_overlay = true)
plot((showLevels and posArmed) ? curSL : na, "Stop Loss", color = color.new(#ef5350, 0),
   style = plot.style_linebr, linewidth = 1, force_overlay = true)
plot((showLevels and posArmed) ? curTP : na, "Take Profit", color = color.new(#26a69a, 0),
   style = plot.style_linebr, linewidth = 1, force_overlay = true)

if longSignal
    alert("LONG signal - " + divName(longDivTyp), alert.freq_once_per_bar_close)
if shortSignal
    alert("SHORT signal - " + divName(shortDivTyp), alert.freq_once_per_bar_close)

// =====================================================================================
//  STATISTICS
// =====================================================================================
//  Closed trades are processed INCREMENTALLY (only the newly closed ones), so the table
//  costs almost nothing even on a 1m chart with thousands of bars. No win/loss streak
//  statistics are shown, as requested.
// =====================================================================================

var int   divTotal   = 0
var int   procTrades = 0
var int   nLongT     = 0
var int   nShortT    = 0
var int   winLongT   = 0
var int   winShortT  = 0
var float sumComm    = 0.0
var float sumR       = 0.0
var int   cntR       = 0

divTotal += divMadeThisBar

if strategy.closedtrades > procTrades
    for i = procTrades to strategy.closedtrades - 1
        float pnl  = strategy.closedtrades.profit(i)
        bool  isLT = strategy.closedtrades.size(i) > 0
        if isLT
            nLongT += 1
            if pnl > 0
                winLongT += 1
        else
            nShortT += 1
            if pnl > 0
                winShortT += 1
        sumComm += nz(strategy.closedtrades.commission(i))
        if array.size(riskQ) > 0
            float rk = array.shift(riskQ)
            if rk > 0
                float ep = strategy.closedtrades.entry_price(i)
                float xp = strategy.closedtrades.exit_price(i)
                sumR += (isLT ? xp - ep : ep - xp) / rk
                cntR += 1
    procTrades := strategy.closedtrades

f_pct(float v) => str.tostring(v * 100.0, "#.##") + " %"
f_num(float v) => str.tostring(v, "#.##")

var table st = table.new(position.top_right, 2, 20, border_width = 1)

cell(int r, string sz, string k, string v, color c) =>
    table.cell(st, 0, r, k, text_color = color.new(color.white, 0), text_size = sz,
       bgcolor = color.new(#1e222d, 0), text_halign = text.align_left)
    table.cell(st, 1, r, v, text_color = c, text_size = sz,
       bgcolor = color.new(#1e222d, 0), text_halign = text.align_right)

if showTable and barstate.islast
    string tpos = tblPos == "Top Left" ? position.top_left
       : tblPos == "Bottom Right" ? position.bottom_right
       : tblPos == "Bottom Left" ? position.bottom_left
       : tblPos == "Middle Right" ? position.middle_right : position.top_right
    string tsz = tblSize == "Tiny" ? size.tiny : tblSize == "Small" ? size.small : size.normal

    table.set_position(st, tpos)

    int   tot  = strategy.closedtrades
    float wr   = tot > 0 ? strategy.wintrades * 1.0 / tot : 0.0
    float pf   = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    float avg  = tot > 0 ? strategy.netprofit / tot : 0.0
    float lwr  = nLongT  > 0 ? winLongT  * 1.0 / nLongT  : na
    float swr  = nShortT > 0 ? winShortT * 1.0 / nShortT : na
    float arr_ = cntR > 0 ? sumR / cntR : na
    int   sigT = sigLongCnt + sigShortCnt

    cell(0, tsz, "CVD-SDS  -  " + timeframe.period,
             intraOk ? "intrabar " + safeLtf : "bar-based", color.new(#ffb300, 0))
    cell(1, tsz, "Divergences found",        str.tostring(divTotal),      color.new(color.white, 0))
    cell(2, tsz, "Signals Generated",        str.tostring(sigT) + "  (L " + str.tostring(sigLongCnt) +
                                         " / S " + str.tostring(sigShortCnt) + ")", color.new(#42a5f5, 0))
    cell(3, tsz, "Trades Actually Opened",   str.tostring(tradesOpened),  color.new(#42a5f5, 0))
    cell(4, tsz, "Signals blocked (in pos.)",str.tostring(blockedSigs),   color.new(color.gray, 0))
    cell(5, tsz, "Total Trades",             str.tostring(tot),           color.new(color.white, 0))
    cell(6, tsz, "Winning Trades",           str.tostring(strategy.wintrades),  colUp)
    cell(7, tsz, "Losing Trades",            str.tostring(strategy.losstrades), colDn)
    cell(8, tsz, "Win Rate",                 f_pct(wr),                   wr >= 0.5 ? colUp : colDn)
    cell(9, tsz, "Profit Factor",            na(pf) ? "n/a" : f_num(pf),  nz(pf) >= 1 ? colUp : colDn)
    cell(10, tsz, "Net Profit",               f_num(strategy.netprofit),   strategy.netprofit >= 0 ? colUp : colDn)
    cell(11, tsz, "Max Drawdown",             f_num(strategy.max_drawdown), colDn)
    cell(12, tsz, "Average P/L",              f_num(avg),                  avg >= 0 ? colUp : colDn)
    cell(13, tsz, "Long Win Rate",            na(lwr) ? "n/a" : f_pct(lwr) + "  (" + str.tostring(nLongT) + ")",
                                         nz(lwr) >= 0.5 ? colUp : colDn)
    cell(14, tsz, "Short Win Rate",           na(swr) ? "n/a" : f_pct(swr) + "  (" + str.tostring(nShortT) + ")",
                                         nz(swr) >= 0.5 ? colUp : colDn)
    cell(15, tsz, "Average R:R (realised)",   na(arr_) ? "n/a" : f_num(arr_) + " R",
                                         nz(arr_) >= 0 ? colUp : colDn)
    cell(16, tsz, "Commission (charged)",     f_num(sumComm) + "  (" + f_num(dispComm) + " %)", color.new(color.gray, 0))
    cell(17, tsz, "Slippage (reference)",     str.tostring(dispSlip) + " ticks", color.new(color.gray, 0))
    cell(18, tsz, "Initial Capital",          f_num(strategy.initial_capital), color.new(color.white, 0))
    cell(19, tsz, "Same-bar TP+SL collisions",str.tostring(collisions) + "  (" +
             (sameBarMode == "Conservative (SL first)" ? "SL first" : "TP first") + ")",
             color.new(color.gray, 0))
